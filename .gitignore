# Generated by Cargo — compiled files and executables
/target
debug

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, storing debugging information
*.pdb

# Generated by cargo mutants — mutation testing data
**/mutants.out*/

# RustRover / JetBrains
#.idea/


#  Python (gemma4 FastAPI service) 
#  Virtual environments
venv/
.venv/
env/
ENV/

#  Python bytecode/cache
__pycache__/
*.pyc
*.pyo
*.pyd

#  Distribution / packaging
*.egg-info/
dist/
build/


#  ML model / cache artifacts 
#  Hugging Face model downloads — these are large and shouldn't be committed;
#  they're re-downloaded via from_pretrained() on first run
.cache/
**/hf_cache/
*.safetensors
*.bin
*.onnx

#  ONNX Runtime cache used by fastembed/ort in database.rs
.cache/ort.pyke.io/


#  Project data 
#  Local SQLite exports, if any get generated on disk
*.db
*.sqlite
*.sqlite3


#  Editor / OS junk
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db


#  Environment / secrets 
.env
.env.local

